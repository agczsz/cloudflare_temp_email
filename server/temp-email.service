[Unit]
Description=Temp Email server (Node + SQLite, cloudflare_temp_email refactor)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/temp-email/server
ExecStart=/usr/bin/node dist/server.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
