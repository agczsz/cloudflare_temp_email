{
  "name": "temp-email-server",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "description": "Node.js runtime for cloudflare_temp_email on a VPS (SQLite + SMTP in, HTTP API + static frontend out)",
  "scripts": {
